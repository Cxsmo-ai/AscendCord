{
  "manifest_version": 3,
  "name": "Tesktop Stereo Proof",
  "version": "0.1.0",
  "description": "Read-only Discord WebRTC receive statistics for Tesktop's local voice verifier.",
  "key": "",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Tesktop Stereo Proof",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["rtc-observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
